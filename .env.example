# ─────────────────────────────────────────────────────────────────────────────
# DesignersMeet CRM — environment variables
# Copy to .env and fill in. Defaults make the app run locally with no cloud deps.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
BACKEND_PORT=4000
FRONTEND_PORT=5173
CORS_ORIGIN=http://localhost:5173

# ─── Data layer ────────────────────────────────────────────────────────────
# memory | dataverse | sqlserver
DATA_PROVIDER=memory

# Dataverse (only required when DATA_PROVIDER=dataverse)
DATAVERSE_URL=https://yourorg.crm.dynamics.com
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# SQL Server (only required when DATA_PROVIDER=sqlserver)
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=designersmeet
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=Designers!Meet1
SQLSERVER_ENCRYPT=false
SQLSERVER_TRUST_SERVER_CERT=true

# ─── Queue layer ──────────────────────────────────────────────────────────
# memory | azure-service-bus | supabase
QUEUE_PROVIDER=memory

# Azure Service Bus (only required when QUEUE_PROVIDER=azure-service-bus)
SERVICE_BUS_NAMESPACE=yournamespace.servicebus.windows.net
SERVICE_BUS_CONNECTION_STRING=

# Supabase queue (only required when QUEUE_PROVIDER=supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_QUEUE_TABLE=order_queue

# ─── Auth ─────────────────────────────────────────────────────────────────
# dev | entra
AUTH_MODE=dev
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUDIENCE=

# ─── Shopify ──────────────────────────────────────────────────────────────
SHOPIFY_STORE_DOMAIN=bj1pcr-h2.myshopify.com
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_ADMIN_TOKEN=

# ─── LinkedIn (live in v1) ────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:4000/auth/linkedin/callback

# ─── Facebook / Instagram (stub in v1) ────────────────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ─── Seed data ────────────────────────────────────────────────────────────
SEED_FREELANCERS_PATH=../../../dm_launch/freelancer_db.json
SEED_SHOPIFY_CSV_PATH=../../../dm_launch/shopify_import.csv
