#!/bin/sh
# DesignersMeet design-lock — commit-msg (Layer 4 brand-change gate).
# Blocks commits that touch locked brief/design paths unless the message
# contains [brand-change]. Manifest: brief/locked-files.json.
ROOT="$(git rev-parse --show-toplevel)"
node "$ROOT/scripts/brand-lock-check.mjs" "$1" || exit 1
exit 0
