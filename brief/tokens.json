{
  "$description": "DesignersMeet design tokens — W3C Design Tokens Community Group (DTCG) format. Derived from brief/tokens.css canonical values. Single source of truth consumed by Style Dictionary. DO NOT hand-edit without a [brand-change] commit.",
  "color": {
    "$type": "color",
    "background":     { "$value": "#FFFFFF", "$description": "Page surface" },
    "sidebar":        { "$value": "#FAFAFA", "$description": "Sidebar surface (half-tone separation)" },
    "hover":          { "$value": "#F9FAFB", "$description": "Hover/active surface 2" },
    "subtle":         { "$value": "#F8FAFC", "$description": "Subtle surface (table head, search)" },
    "border":         { "$value": "#E5E7EB", "$description": "Default chrome line / card border" },
    "border-strong":  { "$value": "#D1D5DB", "$description": "Strong border (inputs)" },
    "border-subtle":  { "$value": "#F1F5F9", "$description": "Subtle border (table rows)" },
    "foreground":     { "$value": "#0F172A", "$description": "Primary text (slate-900)" },
    "secondary":      { "$value": "#475569", "$description": "Secondary text (slate-600)" },
    "muted":          { "$value": "#94A3B8", "$description": "Muted / placeholder (slate-400)" },
    "disabled":       { "$value": "#CBD5E1", "$description": "Disabled text (slate-300)" },
    "primary":        { "$value": "#4F46E5", "$description": "Indigo 600 — primary action ONLY" },
    "primary-hover":  { "$value": "#4338CA", "$description": "Indigo 700 — primary hover" },
    "primary-active": { "$value": "#3730A3", "$description": "Indigo 800 — primary active" },
    "primary-tint":   { "$value": "#EEF2FF", "$description": "Indigo 50 — active nav tint" },
    "primary-tint-2": { "$value": "#E0E7FF", "$description": "Indigo 100 — secondary tint" },
    "success":        { "$value": "#16A34A" },
    "success-tint":   { "$value": "#DCFCE7" },
    "warning":        { "$value": "#D97706" },
    "warning-tint":   { "$value": "#FEF3C7" },
    "danger":         { "$value": "#DC2626" },
    "danger-tint":    { "$value": "#FEE2E2" },
    "info":           { "$value": "#0284C7" },
    "info-tint":      { "$value": "#E0F2FE" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "6px" },
    "lg": { "$value": "8px" },
    "xl": { "$value": "10px" }
  },
  "shadow": {
    "$type": "shadow",
    "pop":  { "$value": "0 1px 2px rgba(15, 23, 42, 0.04), 0 8px 24px rgba(15, 23, 42, 0.08)" },
    "card": { "$value": "0 1px 0 rgba(15, 23, 42, 0.04)" }
  },
  "font": {
    "$type": "fontFamily",
    "sans": { "$value": "'Inter var', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" }
  },
  "canonical": {
    "$description": "Locked brand anchors — verified by .husky/pre-commit and visual regression.",
    "bg": "#FFFFFF",
    "primary": "#4F46E5",
    "sidebar": "#FAFAFA",
    "text": "#0F172A",
    "font": "Inter"
  }
}
