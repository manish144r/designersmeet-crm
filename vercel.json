{
  "version": 2,
  "framework": null,
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "packages/frontend/dist",
  "functions": {
    "api/server.mjs": {
      "maxDuration": 60,
      "memory": 512
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/health",
      "destination": "/api/server"
    },
    {
      "source": "/healthz",
      "destination": "/api/server"
    },
    {
      "source": "/readyz",
      "destination": "/api/server"
    }
  ],
  "env": {
    "AUTH_MODE": "dev",
    "DEMO_BYPASS": "true",
    "DATA_PROVIDER": "memory",
    "QUEUE_PROVIDER": "memory",
    "CORS_ORIGIN": "*"
  }
}