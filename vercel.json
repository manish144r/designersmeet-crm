{
  "version": 2,
  "framework": null,
  "buildCommand": "npm install && npm run build -w @dm/shared && npm run build -w @dm/backend && npm run build -w @dm/frontend",
  "outputDirectory": "packages/frontend/dist",
  "functions": {
    "api/server.mjs": {
      "maxDuration": 60,
      "memory": 512
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/health",
      "destination": "/api/server"
    },
    {
      "source": "/healthz",
      "destination": "/api/server"
    },
    {
      "source": "/readyz",
      "destination": "/api/server"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "AUTH_MODE": "dev",
    "DEMO_BYPASS": "true",
    "DATA_PROVIDER": "memory",
    "QUEUE_PROVIDER": "memory",
    "CORS_ORIGIN": "*"
  }
}