{
    "name":  "@dm/backend",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "main":  "./dist/server.js",
    "scripts":  {
                    "dev":  "tsx watch src/server.ts",
                    "build":  "tsc -p tsconfig.json",
                    "start":  "node dist/server.js",
                    "typecheck":  "tsc -p tsconfig.json --noEmit",
                    "lint":  "eslint src --ext .ts",
                    "seed":  "tsx src/seed.ts",
                    "migrate":  "tsx node_modules/knex/bin/cli.js migrate:latest --knexfile knexfile.ts",
                    "migrate:rollback":  "tsx node_modules/knex/bin/cli.js migrate:rollback --knexfile knexfile.ts",
                    "test":  "vitest run",
                    "test:crm":  "vitest run src/crm",
                    "test:all":  "vitest run",
                    "test:watch":  "vitest"
                },
    "dependencies":  {
                         "@azure/identity":  "^4.2.1",
                         "@azure/service-bus":  "^7.9.4",
                         "@dm/shared":  "*",
                         "@supabase/supabase-js":  "^2.43.4",
                         "compression":  "^1.8.1",
                         "cors":  "^2.8.5",
                         "dataverse-webapi":  "^2.4.5",
                         "dotenv":  "^16.4.5",
                         "express":  "^4.19.2",
                         "express-rate-limit":  "^7.5.1",
                         "helmet":  "^7.1.0",
                         "jose":  "^5.4.0",
                         "jwks-rsa":  "^3.1.0",
                         "knex":  "^3.1.0",
                         "morgan":  "^1.10.0",
                         "mssql":  "^10.0.4",
                         "pino":  "^9.1.0",
                         "pino-http":  "^10.5.0",
                         "pino-pretty":  "^11.1.0",
                         "quick-lru":  "^7.3.0",
                         "uuid":  "^9.0.1",
                         "zod":  "^3.23.8"
                     },
    "devDependencies":  {
                            "@types/compression":  "^1.8.1",
                            "@types/cors":  "^2.8.17",
                            "@types/express":  "^4.17.21",
                            "@types/morgan":  "^1.9.9",
                            "@types/node":  "^20.12.12",
                            "@types/uuid":  "^9.0.8",
                            "tsx":  "^4.11.0",
                            "typescript":  "^5.4.5",
                            "vitest":  "^2.1.9"
                        }
}
