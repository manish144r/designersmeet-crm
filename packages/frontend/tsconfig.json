{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true
  },
  "references": [{ "path": "../shared" }],
  "include": ["src/**/*"],
  "exclude": [
    "src/test/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/pages/06-vendors.tsx",
    "src/pages/11-calendar.tsx",
    "src/pages/12-conversations.tsx",
    "src/pages/13-workflows.tsx",
    "src/pages/15-settings.tsx"
  ]
}
