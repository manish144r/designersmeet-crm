{
  "name": "@dm/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tokens": "node ../../brief/style-dictionary.config.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 5173",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts,.tsx && node scripts/check-no-raw-color.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:ux:full": "playwright test --config=playwright.ux.config.ts",
    "test:ux:critical": "playwright test --config=playwright.ux-critical.config.ts",
    "test:ux:decorative": "playwright test --config=playwright.ux-decorative.config.ts",
    "test:vr:wiring": "playwright test --config=playwright.config.ts wiring-regression.spec.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@azure/msal-browser": "^3.13.0",
    "@azure/msal-react": "^2.0.15",
    "@dm/shared": "*",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@react-oauth/google": "^0.12.1",
    "@tanstack/react-query": "^5.40.0",
    "apple-signin-auth": "^1.7.6",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.408.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.51.5",
    "react-router-dom": "^6.23.1",
    "tailwind-merge": "^2.4.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.2.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.45.0",
    "@storybook/react-vite": "^8.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitest/ui": "^2.1.9",
    "eslint": "^9.9.0",
    "jsdom": "^25.0.1",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "storybook": "^8.2.0",
    "style-dictionary": "^4.4.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.9"
  }
}
