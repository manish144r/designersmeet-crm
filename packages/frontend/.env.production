# Production env — backend on same origin, /api is same-origin (no VITE_API_URL needed).
#
# Microsoft auth: set VITE_MSAL_CLIENT_ID in Vercel env vars to enable real MSAL login.
# When VITE_MSAL_CLIENT_ID is absent the app runs in demo mode (auto-login as admin).
#
# To enable real auth:
#   1. Register an Azure AD App at https://entra.microsoft.com
#      - Redirect URI (SPA): https://<your-vercel-url>
#   2. Add to Vercel project env vars:
#      VITE_MSAL_CLIENT_ID=<app-registration-client-id>
#      VITE_MSAL_TENANT=designersmeet.com   (or your tenant GUID)
#   3. Add to Vercel (server-side, for JWT validation):
#      AUTH_MODE=entra
#      ENTRA_TENANT_ID=<tenant-guid>
#      ENTRA_CLIENT_ID=<app-registration-client-id>
VITE_MSAL_TENANT=designersmeet.com
