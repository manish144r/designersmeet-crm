# Production build env for the static Surge preview.
# Demo mode = true: the deployed static site runs the mutable in-memory
# demoStore (every wired button performs real session CRUD, no backend).
VITE_DEMO_MODE=true
VITE_AUTH_MODE=dev

# When the Render backend is live (Phase 5 / Manish click-through), set
# VITE_DEMO_MODE=false and point this at the Render URL, then rebuild+redeploy.
# VITE_API_URL=https://designersmeet-crm-api.onrender.com
